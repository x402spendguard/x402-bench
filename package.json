{
  "name": "x402-bench",
  "version": "0.1.0",
  "description": "The x402 test bench: a local, honest mock facilitator. Real @x402 signature verification, faked chain — it won't teach you a false green.",
  "type": "module",
  "license": "MIT",
  "author": "Kevin Brown",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/x402spendguard/x402-bench.git"
  },
  "keywords": [
    "x402",
    "facilitator",
    "mock",
    "sandbox",
    "testing",
    "eip-3009",
    "payments",
    "offline"
  ],
  "files": [
    "dist"
  ],
  "bin": {
    "x402-bench": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@x402/core": "~2.18.0",
    "@x402/evm": "~2.18.0",
    "viem": "^2.55.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.4.0",
    "vitest": "^3.2.7"
  }
}
